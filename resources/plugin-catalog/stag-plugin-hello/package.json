{
  "name": "stag-plugin-hello",
  "version": "1.0.0",
  "private": true,
  "description": "Example stag.ai plugin: a word-count tool for agents, buttons and its own pages, counting tasks agents finish, a scheduled job, a webhook.",
  "license": "MIT",
  "type": "module",
  "stagPlugin": {
    "id": "stag.hello",
    "apiVersion": 1,
    "displayName": "Hello",
    "description": "Example plugin: a word_count tool for agents, a \"Say hello\" sidebar button, a button that opens a docs page, its own \"Hello\" page tab, a \"Stats\" settings page, a widget in the agent grid, text in the status bar, counting tasks agents finish, an hourly summary, a \"ping\" webhook.",
    "author": "stag.ai",
    "categories": [
      "example"
    ],
    "capabilities": [
      "agent.tools.register",
      "ui.sidebar.register",
      "ui.action.register",
      "ui.page.register",
      "ui.dashboardWidget.register",
      "instance.settings.register",
      "events.subscribe",
      "agents.read",
      "plugin.state.read",
      "plugin.state.write",
      "ui.notify",
      "jobs.schedule",
      "webhooks.receive"
    ],
    "entrypoints": {
      "worker": "./worker.mjs",
      "ui": "./ui"
    },
    "instanceConfigSchema": {
      "type": "object",
      "properties": {
        "greeting": {
          "type": "string",
          "title": "Greeting",
          "description": "What the \"Say hello\" button shows.",
          "default": "Hello"
        },
        "maxWords": {
          "type": "integer",
          "title": "Word limit",
          "description": "word_count reports going over when the text is longer than this.",
          "default": 500,
          "minimum": 1
        },
        "docsUrl": {
          "type": "string",
          "title": "Docs page",
          "description": "The \"Docs\" button opens this address (with the workspace name) in the app's browser.",
          "default": "https://example.com",
          "format": "url"
        }
      }
    },
    "tools": [
      {
        "name": "word_count",
        "displayName": "Word count",
        "description": "Count the words in a piece of text and say whether it is over the user's limit.",
        "parametersSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "The text to count"
            }
          },
          "required": [
            "text"
          ]
        }
      }
    ],
    "events": [
      "task.done",
      "agent.session.started"
    ],
    "ui": {
      "slots": [
        {
          "type": "sidebar",
          "id": "hello",
          "displayName": "Say hello",
          "action": "hello"
        },
        {
          "type": "agentMenu",
          "id": "stats",
          "displayName": "Stats (Hello)",
          "action": "stats"
        },
        {
          "type": "globalToolbarButton",
          "id": "docs",
          "displayName": "Docs",
          "open": {
            "url": "{config.docsUrl}/?workspace={workspace.name}",
            "target": "browser"
          }
        },
        {
          "type": "page",
          "id": "home",
          "displayName": "Hello",
          "path": "index.html"
        },
        {
          "type": "settingsPage",
          "id": "data",
          "displayName": "Stats",
          "path": "settings.html"
        },
        {
          "type": "dashboardWidget",
          "id": "board",
          "displayName": "Hello · tasks done",
          "path": "widget.html"
        },
        {
          "type": "statusBarItem",
          "id": "done",
          "displayName": "Hello",
          "dataKey": "statusBar",
          "action": "hello"
        }
      ]
    },
    "jobs": [
      {
        "key": "summary",
        "displayName": "Summary",
        "description": "Logs how many tasks each agent has finished.",
        "schedule": "0 * * * *"
      }
    ],
    "webhooks": [
      {
        "endpointKey": "ping",
        "displayName": "Ping",
        "description": "Accepts any JSON, saves it and shows it right away on the Hello page."
      }
    ]
  }
}
