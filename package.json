    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "docx-preview": "^0.4.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "force-graph": "^1.52.0",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "^6.4.299",
    "tailwindcss": "^4.3.3",
