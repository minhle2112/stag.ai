{
  "name": "stag-ai",
  "productName": "stag.ai",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Run a team of AI coding agents per workspace, with a markdown vault as their memory",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "dependencies": {
